# Hostinger server settings for washingtonluisbjj.com
# (GitHub Pages ignores this file.)

# Show the site's own "page not found" page for wrong addresses
ErrorDocument 404 /404.html

RewriteEngine On

# Keep internal files out of public view
RewriteRule ^design-system(/|$) - [R=404,L]
RewriteRule ^\.gitignore$ - [R=404,L]

# One address only: https + www (the temporary hostingersite.com address is left alone)
RewriteCond %{HTTP_HOST} ^washingtonluisbjj\.com$ [NC]
RewriteRule ^(.*)$ https://www.washingtonluisbjj.com/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.washingtonluisbjj\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.washingtonluisbjj.com/$1 [R=301,L]

# Old Wix addresses -> closest page on this site
RewriteRule ^services/?$ /programs.html [R=301,L]
RewriteRule ^service-page/free-trial/?$ /contact.html [R=301,L]
RewriteRule ^service-page/ /programs.html [R=301,L]
RewriteRule ^instructors/?$ /about.html [R=301,L]
RewriteRule ^contact/?$ /contact.html [R=301,L]
RewriteRule ^event-list/?$ /schedule.html [R=301,L]
RewriteRule ^(category|product-page)/ /programs.html [R=301,L]
RewriteRule ^(paywall|blank-3|cookie-policy|privacy-policy|terms-and-conditions)/?$ / [R=301,L]

# Speed: compress text files and let browsers keep images/video/fonts for a month
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
